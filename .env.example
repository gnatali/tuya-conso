# -----------------------------------------------------------------------------
# Tuya configuration  --  copy this file to .env and fill in your values
#   cp .env.example .env
# The .env file must NEVER be committed to version control (see .gitignore).
# -----------------------------------------------------------------------------

# Tuya data center region: eu (Central Europe), us, cn, in
TUYA_API_REGION=eu

# Cloud project credentials (Tuya IoT Platform > project > Overview)
TUYA_API_KEY=YOUR_ACCESS_ID
TUYA_API_SECRET=YOUR_ACCESS_SECRET

# PC321 device ID (TinyTuya wizard or Smart Life app)
TUYA_DEVICE_ID=YOUR_DEVICE_ID

# Meter installation date (format YYYY-MM-DD). Set it wide:
# months with no data are automatically skipped.
INSTALL_DATE=2022-01-01

# Code for the "cumulative energy" quantity.
# Leave empty for auto-detection via /statistics (recommended).
# Common example: add_ele
ENERGY_CODE=
